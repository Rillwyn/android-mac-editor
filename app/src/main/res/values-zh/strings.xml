    <!-- 贡献者按版本做了什么（子级下拉内容） -->
    <string-array name="about_contrib_rillwyn">
        <item>v0.2.0 —— 核心重写：将模块迁移到 libxposed Modern Xposed API（API 101），重建 UI（Material 3 状态诊断、MAC 编辑器、三页导航）。</item>
        <item>v0.2.1 —— 仓库维护：整合社区 PR #1（多厂商支持、零点击生效、阿拉伯语与 RTL），搭建 CI 自动构建/发布与文档。</item>
        <item>v0.2.5 —— 仓库维护：升级支持 libxposed API 102、UI 打磨（Material 3 语言下拉框与关于页滚动修复）及版本同步与发布管理。</item>
    </string-array>
    <string-array name="about_contrib_amr">
        <item>v0.2.1 —— PR #1：多厂商 Wi-Fi 栈兼容、零点击即时生效、阿拉伯语本地化与 RTL 布局、文档与 KDoc。</item>
        <item>v0.2.5 —— 动态 RTL/LTR 无缝切换（无需手动杀死重启）、关于页展开超出屏幕无法滚动问题修复及 API 102 现代支持。</item>
    </string-array>
